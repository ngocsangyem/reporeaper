{
  "name": "reporeaper",
  "version": "0.1.0",
  "description": "Batch archive or delete your personal GitHub repos from a TUI, a CLI, or a local web UI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "reporeaper": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "github",
    "cli",
    "tui",
    "repository",
    "cleanup",
    "archive"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@reporeaper/core": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "msw": "^2.15.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  }
}
